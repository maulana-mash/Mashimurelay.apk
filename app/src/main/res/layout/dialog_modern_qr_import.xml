<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#141624"
    app:cardCornerRadius="16dp"
    app:cardElevation="16dp"
    app:strokeColor="#2d3148"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#11131f"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_qr_scan"
                app:tint="#38bdf8"
                android:contentDescription="QR Icon" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Tugas Sirkuit Terdeteksi"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseQrImport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="#94a3b8" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262a40" />

        <!-- Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Circuit Name Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1a1c2e"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Sirkuit:"
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvQrCircuitName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Praktikum 1 - DOL Starter"
                    android:textColor="#38bdf8"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Protection Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status Posisi:"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvQrLockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Guru Terkunci"
                    android:textColor="#10b981"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kit Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kit Komponen:"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvQrKitStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="DOL Starter"
                    android:textColor="#a78bfa"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Option 1: Buka Langsung di Proyek Baru -->
            <Button
                android:id="@+id/btnQrOpenDirectly"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Buka Langsung di Proyek Baru"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#0284c7"
                app:cornerRadius="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Option 2: Simpan ke Proyek Saya -->
            <Button
                android:id="@+id/btnQrSaveToWorkspace"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Simpan ke Proyek Saya"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#059669"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
