<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111114"
    android:orientation="vertical">

    <!-- Top Header Bar: Centered QR Icon & Title (Workspace Simurelay Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#16161c"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_qr_scan"
            app:tint="#38bdf8"
            android:contentDescription="QR Icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Pindai QR Tugas"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e1e28" />

    <!-- Instruction Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arahkan kamera ke kode QR tugas"
            android:textColor="#e2e8f0"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Posisikan QR code tepat di dalam bingkai pemindai"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Camera Viewfinder with 4 Corner Brackets OUTSIDE the scanner window -->
    <FrameLayout
        android:layout_width="290dp"
        android:layout_height="266dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp">

        <!-- 4 Outer Corner Brackets (Outside Camera Window) -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:src="@drawable/ic_corner_bracket_tl"
            android:contentDescription="Corner TL" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:src="@drawable/ic_corner_bracket_tr"
            android:contentDescription="Corner TR" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:src="@drawable/ic_corner_bracket_bl"
            android:contentDescription="Corner BL" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_corner_bracket_br"
            android:contentDescription="Corner BR" />

        <!-- Camera Preview Window (Clean, Unobstructed Inside) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="260dp"
            android:layout_height="236dp"
            android:layout_gravity="center"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#2a2d3d"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#111114">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.journeyapps.barcodescanner.DecoratedBarcodeView
                    android:id="@+id/zxing_barcode_scanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:zxing_use_texture_view="true"
                    app:zxing_preview_scaling_strategy="centerCrop" />

                <!-- Subtle horizontal laser scan line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_gravity="center_vertical"
                    android:background="#38bdf8"
                    android:alpha="0.75" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Workspace Status Card (Wi-Fi Icon & Device Telemetry) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_workspace_status"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_scan_icon_container">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wifi"
                app:tint="#38bdf8"
                android:contentDescription="Wi-Fi Icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sinkronisasi Workspace Siap"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusDeviceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Samsung Galaxy SM-A525F • 192.168.137.15"
                android:textColor="#94a3b8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Action Bar (Senter & Pilih dari Galeri) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Secondary Button: Senter / Flash -->
        <LinearLayout
            android:id="@+id/btnToggleTorch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_scanner_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/ivTorchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_flashlight"
                app:tint="#f4f4f5"
                android:contentDescription="Senter Icon" />

            <TextView
                android:id="@+id/tvTorchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Senter"
                android:textColor="#f4f4f5"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Primary Button: Pilih dari Galeri -->
        <LinearLayout
            android:id="@+id/btnPickFromGallery"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_btn_scanner_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_gallery"
                app:tint="#ffffff"
                android:contentDescription="Gallery Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Pilih dari Galeri"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
