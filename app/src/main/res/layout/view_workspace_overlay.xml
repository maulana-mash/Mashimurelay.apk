<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutWorkspaceOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111114"
    android:orientation="vertical"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <!-- Top Toolbar (Dynamic Title + Tab-Aware Actions) -->
    <LinearLayout
        android:id="@+id/workspaceTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#16161c"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btnWorkspaceBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvWorkspaceHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Workspace"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPmDeleteDetail"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:text="Hapus"
            android:textColor="#f87171"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnNewProject"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_workspace_add"
            android:contentDescription="New Project" />

        <ImageView
            android:id="@+id/btnWorkspaceImport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_import"
            android:contentDescription="Import Circuit (.smrl / .txt)" />

        <ImageView
            android:id="@+id/btnWorkspaceScanQr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_qr_scan"
            app:tint="#38bdf8"
            android:contentDescription="Scan QR Circuit Tugas Guru" />

        <ImageView
            android:id="@+id/btnWorkspaceThemeToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_theme_sun"
            android:contentDescription="Ganti Tema" />

        <ImageView
            android:id="@+id/btnWorkspaceMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="More Options" />
    </LinearLayout>

    <View
        android:id="@+id/workspaceTopDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e1e28" />

    <!-- Center Content Container: Switches smoothly between Workspace/Examples and Inline Modules Page -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Page A: Workspace / Examples RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWorkspaceProjects"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- Page B: Inline Full-Screen Modul Praktikum (List + Detail) -->
        <LinearLayout
            android:id="@+id/layoutInlineModulesPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- MODUL LIST VIEW -->
            <LinearLayout
                android:id="@+id/layoutPmListView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <!-- Filter Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/pmFilterContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipFilterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Semua"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterIndustri"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Industri (TITL)"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterOtomotif"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Otomotif (TKR/TSM)"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterGuru"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Modul Guru (0)"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Search Box -->
                <EditText
                    android:id="@+id/etPmSearch"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Cari judul, materi, atau komponen..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#f8fafc"
                    android:textColorHint="#64748b"
                    android:textSize="12.5sp" />

                <!-- Cards List -->
                <ScrollView
                    android:id="@+id/svPmCards"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/pmCardsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="12dp" />
                </ScrollView>
            </LinearLayout>

            <!-- MODUL DETAIL VIEW (Full Page, Bottom Bar Hidden) -->
            <LinearLayout
                android:id="@+id/layoutPmDetailView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <ScrollView
                    android:id="@+id/svPmDetail"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp">

                    <LinearLayout
                        android:id="@+id/pmDetailBodyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp" />
                </ScrollView>

                <View
                    android:id="@+id/pmFooterDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#262636" />

                <!-- Detail Action Footer (Cohesive Slate-Blue & Primary Blue Palette) -->
                <LinearLayout
                    android:id="@+id/pmDetailFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPmActionVideo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:elevation="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:stateListAnimator="@null"
                        android:text="Video"
                        android:textAllCaps="false"
                        android:textColor="#cbd5e1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:strokeColor="#3b475c"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPmActionExample"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:elevation="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:stateListAnimator="@null"
                        android:text="Buka Contoh"
                        android:textAllCaps="false"
                        android:textColor="#cbd5e1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        app:strokeColor="#3b475c"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPmActionPractice"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:elevation="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:stateListAnimator="@null"
                        android:text="Latihan (+ Kit)"
                        android:textAllCaps="false"
                        android:textColor="#ffffff"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#2563eb"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/workspaceBottomDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e1e28" />

    <!-- Bottom Navigation Bar: Modul (Kiri) | Workspace (Tengah) | Examples (Kanan) -->
    <LinearLayout
        android:id="@+id/workspaceBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#16161c"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Tab 1 (Kiri): Modul -->
        <LinearLayout
            android:id="@+id/tabModules"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pillTabModules"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/ivTabModulesIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_modules"
                    app:tint="#64748b"
                    android:contentDescription="Modul Icon" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTabModulesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Modul"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Tab 2 (Tengah - Default): Workspace -->
        <LinearLayout
            android:id="@+id/tabWorkspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pillTabWorkspace"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_pill_active"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/ivTabWorkspaceIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_workspace"
                    app:tint="#ffffff"
                    android:contentDescription="Workspace Icon" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTabWorkspaceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Workspace"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 3 (Kanan): Examples -->
        <LinearLayout
            android:id="@+id/tabExamples"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pillTabExamples"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_pill_inactive"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/ivTabExamplesIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_nav_examples"
                    app:tint="#64748b"
                    android:contentDescription="Examples Icon" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTabExamplesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Examples"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:textStyle="normal" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
