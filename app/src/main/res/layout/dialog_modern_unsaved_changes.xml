<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#141624"
    app:cardCornerRadius="16dp"
    app:cardElevation="16dp"
    app:strokeColor="#2d3148"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#11131f"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_status_badge_off">

                <ImageView
                    android:id="@+id/ivUnsavedHeaderIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_save"
                    app:tint="#38bdf8"
                    android:contentDescription="Save Icon" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUnsavedHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Perubahan Belum Disimpan"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseUnsaved"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="#94a3b8"
                android:contentDescription="Close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#262a40" />

        <!-- Message Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvUnsavedMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Proyek ini memiliki perubahan yang belum disimpan. Apakah Anda ingin menyimpannya sebelum kembali ke Workspace?"
                android:textColor="#cbd5e1"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Actions (Vertically Stacked for High Readability) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- 1. Save (Primary Action) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveUnsaved"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Save (Simpan)"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#2563eb"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="#ffffff"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- 2. Don't Save (Secondary Action) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDontSaveUnsaved"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="Don't Save (Jangan Simpan)"
                android:textColor="#f87171"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#1c1e2d"
                app:strokeColor="#3a3f5c"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="#f87171"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- 3. Cancel (Dismiss Action) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelUnsaved"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="Cancel (Batal)"
                android:textColor="#94a3b8"
                android:textSize="12.5sp"
                android:textAllCaps="false"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#2d3148"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
