                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#282834" />

                <!-- 5. About -->
                <LinearLayout
                    android:id="@+id/menuDrawerAbout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
