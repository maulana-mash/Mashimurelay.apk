<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121216">

    <!-- Container Utama: Canvas CAD + Workspace Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/mainCoordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121216">

            <!-- Top AppBar with Horizontal Scrolling Support (Anti-Cutoff pada HP) -->
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#14141a">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/topToolbarLayout"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <!-- 1. [ ☰ MENU ] -->
                        <LinearLayout
                            android:id="@+id/btnOpenMenu"
                            android:layout_width="52dp"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_toolbar_menu"
                                android:contentDescription="Menu" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="MENU"
                                android:textColor="#ffffff"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 2. [ ⊞+ LIBRARY ] -->
                        <LinearLayout
                            android:id="@+id/btnToggleLibrary"
                            android:layout_width="54dp"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivToolbarLibraryIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_toolbar_library"
                                android:contentDescription="Library" />

                            <TextView
                                android:id="@+id/tvToolbarLibraryLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="LIBRARY"
                                android:textColor="#ffffff"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="#272734" />



                        <!-- 3. [ ▶ PLAY ] / [ ⏹ STOP ] -->
                        <LinearLayout
                            android:id="@+id/btnRun"
                            android:layout_width="52dp"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_toolbar_play"
                                android:contentDescription="Play" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="PLAY"
                                android:textColor="#ffffff"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnStop"
                            android:layout_width="52dp"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:visibility="gone"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_toolbar_stop"
                                android:contentDescription="Stop" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="STOP"
                                android:textColor="#ffffff"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Flexible Spacer between Left Controls (Menu, Library, Play) and Right Controls (Undo, Redo, More) -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <!-- 4. [ ↶ UNDO ] -->
                        <LinearLayout
                            android:id="@+id/btnUndo"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_undo"
                                android:contentDescription="Undo" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="UNDO"
                                android:textColor="#ffffff"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 5. [ ↷ REDO ] -->
                        <LinearLayout
                            android:id="@+id/btnRedo"
                            android:layout_width="48dp"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_redo"
                                android:contentDescription="Redo" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="REDO"
                                android:textColor="#ffffff"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="#272734" />

                        <!-- 6. [ ⋮ MORE ] (Pojok Kanan Atas) -->
                        <LinearLayout
                            android:id="@+id/btnToolbarMore"
                            android:layout_width="50dp"
                            android:layout_height="match_parent"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_toolbar_more"
                                android:contentDescription="More" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="MORE"
                                android:textColor="#ffffff"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>
            </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Native Canvas View (Full GPU Accelerated) -->
    <com.mashimurelay.app.nativecad.NativeCanvasView
        android:id="@+id/canvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Visual Component Library Side Panel (Gambar 3 Simurelay - Visual Grid 3-Kolom) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panelLibrary"
        android:layout_width="225dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|top"
        android:layout_marginTop="52dp"
        android:visibility="gone"
        app:cardBackgroundColor="#13131c"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:strokeColor="#262638"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Category Selector Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#1c1c28"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#38bdf8"
                    android:popupBackground="#1c1c28" />

                <Button
                    android:id="@+id/btnCloseLibrary"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="✕"
                    android:textColor="#94a3b8"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3-Column Grid of Component Vector Thumbnails -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComponentLibrary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="4dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contextual Floating Action Pill (Anti-Cutoff & Ramping) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floatingPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="#f213131e"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <!-- Selected Element Tag Badge -->
                <TextView
                    android:id="@+id/pillLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="100dp"
                    android:singleLine="true"
                    android:text="-KM1"
                    android:textColor="#38bdf8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Switch Options (Pos I, Pos 0, Pos II atau ON, OFF) -->
                <LinearLayout
                    android:id="@+id/pillSwitchOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnPos1"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#1e293b"
                        android:includeFontPadding="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Pos I"
                        android:textColor="#ffffff"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPos0"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#1e293b"
                        android:includeFontPadding="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Pos 0"
                        android:textColor="#fbbf24"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPos2"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#1e293b"
                        android:includeFontPadding="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Pos II"
                        android:textColor="#ffffff"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Edit Actions (Rotate, Tag, Delete) -->
                <LinearLayout
                    android:id="@+id/pillEditControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRotate"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#262638"
                        android:includeFontPadding="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Putar"
                        app:icon="@drawable/ic_screen_rotation"
                        app:iconSize="13dp"
                        app:iconTint="#ffffff"
                        android:textColor="#ffffff"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnTag"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#262638"
                        android:includeFontPadding="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Tag"
                        app:icon="@drawable/ic_edit"
                        app:iconSize="13dp"
                        app:iconTint="#ffffff"
                        android:textColor="#ffffff"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#7f1d1d"
                        android:includeFontPadding="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Hapus"
                        app:icon="@drawable/ic_delete"
                        app:iconSize="13dp"
                        app:iconTint="#fca5a5"
                        android:textColor="#fca5a5"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Zoom Controls Widget (Gambar 3 Simurelay - [- | +]) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardZoomWidget"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="84dp"
        app:cardBackgroundColor="#d9161622"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:strokeColor="#2d2d42"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnZoomOut"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:background="#2d2d42" />

            <Button
                android:id="@+id/btnZoomIn"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Short Circuit Alert Banner (Melayang Rapi di Bawah Bilah Menu Atas) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardShortCircuit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:visibility="gone"
        app:cardBackgroundColor="#f0dc2626"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/tvAlertShortCircuit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHORT CIRCUIT! Periksa fasa &amp; netral"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseAlert"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="✕"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- FAB for Adding Components (Membuka / Menutup Visual Library Panel) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="#2563eb"
        android:contentDescription="Tambah Komponen"
        app:elevation="14dp"
        app:srcCompat="@drawable/ic_fab_plus"
        app:tint="#ffffff" />

    <!-- Floating Exit Fullscreen Button (Pojok Kiri Atas, Persis Gambar 4) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnExitFullscreen"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#d916161c"
        app:cardCornerRadius="8dp"
        app:cardElevation="10dp"
        app:strokeColor="#40ffffff"
        app:strokeWidth="1dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Keluar Layar Penuh"
            android:src="@drawable/ic_exit_fullscreen" />
    </com.google.android.material.card.MaterialCardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- Workspace Full-screen Overlay (Gambar 2) -->
        <include layout="@layout/view_workspace_overlay" />

        <!-- Startup Loading Screen Overlay -->
        <FrameLayout
            android:id="@+id/layoutLoadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#01143a"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible">

            <WebView
                android:id="@+id/webViewLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#01143a" />

        </FrameLayout>

    </FrameLayout>

    <!-- Simurelay Slide-in Left Drawer (Gambar 1) -->
    <LinearLayout
        android:id="@+id/leftDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#141418"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Modern Blue Drawer Header (Mashimurelay di pojok atas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:background="#0284c7"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Mashimurelay Logo"
                    android:src="@drawable/logo_drawer_menu" />

                <TextView
                    android:id="@+id/tvDrawerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Mashimurelay"
                    android:textColor="#ffffff"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDrawerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="DOL Motor Starter"
                android:textColor="#e0f2fe"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Drawer Menu Items List -->
        <ScrollView
            android:id="@+id/leftDrawerScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="24dp">

                <!-- 1. Workspace -->
                <LinearLayout
                    android:id="@+id/menuDrawerWorkspace"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Workspace"
                        android:src="@drawable/ic_menu_workspace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
